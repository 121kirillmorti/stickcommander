<?xml version="1.0" encoding="utf-8"?>
<!-- USB devices StickCommander can talk to out of the box.
     usb-serial-for-android probes the actual driver, this filter only controls
     the "open app on attach" behaviour and USB permission UI. -->
<resources>
    <!-- Espressif native USB (ESP32-S3 / M5StickC Plus 2 in CDC mode) -->
    <usb-device vendor-id="12586" product-id="4097" />
    <!-- CH340 / CH341 -->
    <usb-device vendor-id="6790" product-id="29987" />
    <!-- CH9102 variants -->
    <usb-device vendor-id="6790" product-id="21972" />
    <usb-device vendor-id="6790" product-id="21971" />
    <!-- CP2102 / CP2104 -->
    <usb-device vendor-id="4292" product-id="60000" />
    <!-- FTDI FT232 -->
    <usb-device vendor-id="1027" product-id="24577" />
    <!-- Prolific PL2303 -->
    <usb-device vendor-id="1659" product-id="8963" />
</resources>
